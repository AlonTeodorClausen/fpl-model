# Python bytecode, packaging and build output
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
/build/
/dist/

# Virtual environments and local environment settings
.venv/
venv/
env/
ENV/
.env
.env.*
!.env.example

# Test, lint and type-check caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.ipynb_checkpoints/

# Local datasets and generated model/forecast/backtest artifacts
# Keep directory placeholders; model source under src/ remains tracked.
/data/raw/*
!/data/raw/.gitkeep
/data/processed/*
!/data/processed/.gitkeep
/models/*
!/models/.gitkeep
/artifacts/

# Editor and operating-system files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
